use move_vm_runtime::native_functions::NativeContext;
use move_core_types::{value::Value, account_address::AccountAddress};
use move_vm_types::values::Value as MoveValue;
use move_vm_types::values::Vector;
use std::collections::HashSet;
use std::sync::Mutex;
use once_cell::sync::Lazy;

static PAYER_ADDRESS_CACHE: Lazy<Mutex<HashSet<AccountAddress>>> = Lazy::new(|| Mutex::new(HashSet::new()));

// native fun record_payer_address(addr: address)
pub fn native_record_payer_address(
	_context: &mut NativeContext,
	ty_args: Vec<move_core_types::language_storage::TypeTag>,
	mut args: Vec<MoveValue>,
) -> Result<(Option<MoveValue>, u64), move_vm_runtime::native_functions::NativeResult> {
	let addr = match args.pop() {
		Some(MoveValue::Address(a)) => a,
		_ => return Err(move_vm_runtime::native_functions::NativeResult::err(0)),
	};
	let mut cache = PAYER_ADDRESS_CACHE.lock().unwrap();
	cache.insert(addr);
	Ok((None, 0))
}

// native fun read_and_clear_payer_address(): vector<address>
pub fn native_read_and_clear_payer_address(
	_context: &mut NativeContext,
	_ty_args: Vec<move_core_types::language_storage::TypeTag>,
	_args: Vec<MoveValue>,
) -> Result<(Option<MoveValue>, u64), move_vm_runtime::native_functions::NativeResult> {
	let mut cache = PAYER_ADDRESS_CACHE.lock().unwrap();
	let mut addresses: Vec<AccountAddress> = cache.drain().collect();
	addresses.sort();
	addresses.dedup();
	let vec_value = MoveValue::Vector(addresses.into_iter().map(MoveValue::Address).collect());
	Ok((Some(vec_value), 0))
}
